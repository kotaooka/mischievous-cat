rules_version = '2';
// こっそりネコ：みんなのランキングのルール
// 読み取りはだれでも可。
// 記録を足せるのは、匿名ログイン中の本人だけ（記録の uid がログインした人の uid と同じこと）。
// 書き換えは、その記録の本人が「名前」だけを変えるときに限る。削除はできない。
// 値の範囲を確かめて、明らかにおかしい記録をはじく（ブラウザから送るので、完全には改ざんを防げない）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && valid(request.resource.data)
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if false;
    }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 10;
    }
    function valid(d) {
      return d.keys().hasOnly(['name', 'y', 's', 'st', 'c', 'uid', 'sk', 'v'])
        && d.keys().hasAll(['name', 'y', 's', 'st', 'c', 'uid', 'sk', 'v'])
        && validName(d.name)
        && d.s is int && d.s >= 1 && d.s <= 200
        // 被害額：1円以上、ステージ数 × 100万円以下
        && d.y is int && d.y >= 1 && d.y <= d.s * 1000000
        // ★：1面につき最大3個
        && d.st is int && d.st >= 0 && d.st <= d.s * 3
        && d.c in ['kuro', 'cha', 'saba', 'maine', 'mike']
        && d.uid is string && d.uid.size() >= 8 && d.uid.size() <= 40
        && d.sk is int && d.sk >= 0 && d.sk <= d.y
        && d.v is int;
    }
  }
}
